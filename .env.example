# Copy this file to .env and edit the values.  .env is git-ignored - never commit secrets.

# Local Postgres + pgvector (started by docker compose)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Embedding model (free, runs locally)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# LLM - pick ONE option:
# Option A: Ollama running locally (free)  -> install from ollama.com, then: ollama pull llama3.2
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
# Option B: Groq (free tier) -> get a key at console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.1-8b-instant
# Option C: Google Gemini (free tier) -> get a key at aistudio.google.com
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
